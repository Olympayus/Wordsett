{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "collector",
  "description": "划词小窗（collector 窗口）的最小权限集",
  "windows": [
    "collector"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-set-background-color"
  ]
}
