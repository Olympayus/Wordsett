{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lexiloom",
  "version": "0.4.4",
  "identifier": "com.lexiloom.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lexiloom",
        "width": 1080,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../public/dictionaries/ecdict.db": "ecdict.db",
      "../public/dictionaries/wordnet.db": "wordnet.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MEYyQ0M3OEY3QUYxMDQKUldRRThYcVB4eXdQZFNXZElWRlc5NGZ1RThwQnBkajE3VVgvVnl0OG9CV0VrdDZGbWhrS3owUHIK",
      "endpoints": [
        "https://raw.githubusercontent.com/Olympayus/Lexiloom/main/latest.json"
      ]
    }
  }
}
